# PAYER-side config - this wallet SENDS the payment to the tollbooth.
# Fund it from https://faucet.altnet.rippletest.net/accounts before use.
PAYER_SEED=sYOUR_PAYER_TESTNET_SEED_HERE
PAYER_ADDRESS=rYOUR_PAYER_TESTNET_ADDRESS_HERE

# Target tollbooth (default = local server)
TOLLBOOTH_URL=http://localhost:8787
TARGET_PATH=/wallet-risk

# Sample request body (matches the /wallet-risk stub)
REQUEST_BODY={"chain":"eth","address":"0x0000000000000000000000000000000000000000"}
