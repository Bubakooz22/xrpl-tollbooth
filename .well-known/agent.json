{
  "schema_version": "agent-manifest/1.0",
  "name": "xrpl-tollbooth",
  "display_name": "XRPL Toll Booth \u2014 Cybersecurity API",
  "description": "Pay-per-call cybersecurity endpoints for Web3 agents and auditors, settled on the XRP Ledger via x402. Wallet risk, contract risk, transaction simulation, bounty-scope lookup, and Foundry PoC verification.",
  "version": "2026.09.29",
  "version_policy": "Documentation revision; response-envelope protocol remains 0.8.",
  "pricing_observed_at": "2026-09-29",
  "pricing_policy": "Fresh endpoint challenge is authoritative. Network fees may be additional.",
  "homepage": "https://github.com/Bubakooz22/xrpl-tollbooth",
  "openapi": "/.well-known/openapi.json",
  "contact": {
    "name": "transactionguardian2025",
    "url": "https://github.com/Bubakooz22/xrpl-tollbooth/issues"
  },
  "networks": {
    "primary": {
      "kind": "xrpl-mainnet",
      "network": "xrpl:0",
      "x402_version": 2,
      "merchant_address": "rK1C1DPzJo9gSjK2LSdhV5J5veFB84zHer",
      "facilitator_url": "https://xrpl-facilitator-mainnet.t54.ai",
      "scheme": "exact"
    }
  },
  "auth_models": [
    {
      "id": "x402",
      "description": "Pay per call on XRPL mainnet. First request returns 402 with payment requirements over HTTPS, not a signed report. Validate terms and cap spending before signing and retrying. Payment precedes body validation.",
      "docs": "docs/x402-spec-notes.md"
    },
    {
      "id": "bearer_api_key",
      "description": "Existing Bearer API keys apply to /auth-ping, not the five x402-paid routes.",
      "header": "Authorization",
      "format": "Bearer tb_live_<32hex>",
      "docs": "docs/api-key-auth.md"
    }
  ],
  "endpoints": [
    {
      "id": "wallet-risk",
      "method": "POST",
      "path": "/wallet-risk",
      "auth": "x402",
      "summary": "Score a wallet address for OFAC + scam-list membership across ETH, XRPL, SOL.",
      "pricing": [
        {
          "asset": "XRP",
          "amount_drops": 5000
        },
        {
          "asset": "RLUSD",
          "amount": "0.002",
          "issuer": "rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De",
          "currency_hex": "524C555344000000000000000000000000000000"
        }
      ],
      "input_schema_ref": "/.well-known/openapi.json#/components/schemas/WalletRiskRequest",
      "output_schema_ref": "/.well-known/openapi.json#/components/schemas/WalletRiskResponse",
      "reason_codes": [
        "OFAC_SANCTIONED",
        "SCAM_LIST_HIT",
        "UNKNOWN_ADDRESS"
      ]
    },
    {
      "id": "contract-risk",
      "method": "POST",
      "path": "/contract-risk",
      "auth": "x402",
      "summary": "Score a smart contract for known-exploit database matches plus source heuristics.",
      "pricing": [
        {
          "asset": "XRP",
          "amount_drops": 5000
        },
        {
          "asset": "RLUSD",
          "amount": "0.002",
          "issuer": "rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De",
          "currency_hex": "524C555344000000000000000000000000000000"
        }
      ],
      "input_schema_ref": "/.well-known/openapi.json#/components/schemas/ContractRiskRequest",
      "output_schema_ref": "/.well-known/openapi.json#/components/schemas/ContractRiskResponse",
      "reason_codes": [
        "KNOWN_EXPLOIT_MATCH",
        "SELFDESTRUCT_PRESENT",
        "DELEGATECALL_PRESENT",
        "PROXY_UPGRADEABLE",
        "SOURCE_UNVERIFIED"
      ]
    },
    {
      "id": "tx-simulate-risk",
      "method": "POST",
      "path": "/tx-simulate-risk",
      "auth": "x402",
      "summary": "Simulate an Ethereum transaction on a mainnet fork; detect unlimited approvals, ownership transfer, proxy upgrades, selfdestruct, reverts, multi-token outbound flows.",
      "pricing": [
        {
          "asset": "XRP",
          "amount_drops": 5000
        },
        {
          "asset": "RLUSD",
          "amount": "0.002",
          "issuer": "rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De",
          "currency_hex": "524C555344000000000000000000000000000000"
        }
      ],
      "input_schema_ref": "/.well-known/openapi.json#/components/schemas/TxSimulateRiskRequest",
      "output_schema_ref": "/.well-known/openapi.json#/components/schemas/TxSimulateRiskResponse",
      "reason_codes": [
        "TOKEN_APPROVAL_GRANTED",
        "UNLIMITED_APPROVAL_GRANTED",
        "OWNERSHIP_TRANSFERRED",
        "PROXY_UPGRADED",
        "SELFDESTRUCT_INVOKED",
        "TX_REVERTED",
        "MULTIPLE_OUTBOUND_TOKEN_TRANSFERS"
      ]
    },
    {
      "id": "scope-check",
      "method": "POST",
      "path": "/scope-check",
      "auth": "x402",
      "summary": "Check whether an address is in scope of any known bug bounty program.",
      "pricing": [
        {
          "asset": "XRP",
          "amount_drops": 5000
        },
        {
          "asset": "RLUSD",
          "amount": "0.002",
          "issuer": "rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De",
          "currency_hex": "524C555344000000000000000000000000000000"
        }
      ],
      "input_schema_ref": "/.well-known/openapi.json#/components/schemas/ScopeCheckRequest",
      "output_schema_ref": "/.well-known/openapi.json#/components/schemas/ScopeCheckResponse",
      "coverage_note": "Local dataset lookup; exact coverage and refresh cadence are not guaranteed. Confirm the program's current official scope before acting."
    },
    {
      "id": "verify-poc",
      "method": "POST",
      "path": "/verify-poc",
      "auth": "x402",
      "beta": true,
      "summary": "Grade a Foundry PoC (.t.sol) against an Ethereum mainnet fork. Returns verified true/false and a reason code.",
      "pricing": [
        { "asset": "XRP", "amount_drops": 5000 },
        { "asset": "RLUSD", "amount": "0.002", "issuer": "rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De", "currency_hex": "524C555344000000000000000000000000000000" }
      ],
      "operational_note": "No per-key application rate limit is enforced by this x402 handler. Paid-route workload admission is pending separate review; no latency SLA.",
      "input_schema_ref": "/.well-known/openapi.json#/components/schemas/VerifyPocRequest",
      "output_schema_ref": "/.well-known/openapi.json#/components/schemas/VerifyPocResponse",
      "reason_codes": [
        "POC_VERIFIED",
        "POC_UNVERIFIED",
        "COMPILE_ERROR",
        "PARSE_FAILURE",
        "NO_TESTS_FOUND",
        "TIMEOUT",
        "RPC_UNREACHABLE",
        "MISSING_TEST_FILE",
        "INVALID_BASE64",
        "TEST_FILE_TOO_LARGE",
        "UNSUPPORTED_CHAIN",
        "INVALID_EXPECTED_RESULT",
        "FFI_DISALLOWED",
        "FS_WRITE_DISALLOWED",
        "ENV_WRITE_DISALLOWED",
        "FORGE_STD_BOOTSTRAP_FAILED",
        "INTERNAL_ERROR"
      ],
      "constraints": {
        "single_file_only": true,
        "max_source_bytes": 131072,
        "chains": [
          "eth"
        ],
        "banned_cheatcodes": [
          "vm.ffi",
          "vm.writeFile",
          "vm.setEnv",
          "vm.closeFile",
          "vm.removeFile"
        ]
      }
    },
    {
      "id": "auth-ping",
      "method": "GET",
      "path": "/auth-ping",
      "auth": "bearer_api_key",
      "summary": "Verify a Bearer API key works. No side effects.",
      "rate_limit": {
        "per_minute": 60
      }
    }
  ],
  "conventions": {
    "reason_codes": "Successful legacy risk results carry reason-code objects; legacy PoC results carry strings. v0.8 normalizes these to objects. Error bodies may not have reason_codes.",
    "risk_levels": [
      "low",
      "medium",
      "high",
      "critical"
    ],
    "chains": [
      "eth",
      "xrpl",
      "sol"
    ],
    "cache_policy": "Do not infer replay, free retry or refund guarantees from cache_ttl_seconds or envelope expiry."
  },
  "signed_responses": {
    "accept": "application/vnd.tollbooth.v0.8+json",
    "endpoints": ["wallet-risk", "contract-risk", "tx-simulate-risk", "verify-poc"],
    "status": 200,
    "schema_ref": "/.well-known/openapi.json#/components/schemas/SignedResponseV08",
    "keys": "/.well-known/tollbooth-keys.json",
    "limitations": "Requires signing enabled. Scope and errors are not wrapped. Signing failure may return legacy JSON with X-Tollbooth-V08-Warning. Report signature does not cover the settlement receipt or raw simulation success/revert/gas/trace fields."
  },
  "verification": {
    "observed_at": "2026-09-29",
    "paid_case": "Operator-funded XRP-mainnet tx-simulate-risk unlimited DAI approval with receipt and signature verified.",
    "attribution": "INTERNAL_TEST",
    "limits": "Not proof of external revenue, all five paid capabilities, all transaction categories, or RLUSD end-to-end execution."
  }
}
